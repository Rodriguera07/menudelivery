'use client';

import { useState } from 'react';
import { formatBRL, parseBRL } from '@/lib/format';

type Product = {
  id: string;
  name: string;
  category: string;
  description: string | null;
  price: number;
  promoPrice: number | null;
  active: boolean;
  sold: number;
};

function normalizeProduct(raw: Product): Product {
  return { ...raw, price: Number(raw.price), promoPrice: raw.promoPrice !== null ? Number(raw.promoPrice) : null };
}

export default function ProductsManager({ initialProducts }: { initialProducts: Product[] }) {
  const [products, setProducts] = useState(initialProducts);
  const [form, setForm] = useState({ name: '', category: '', price: '', promoPrice: '', description: '' });
  const [error, setError] = useState('');
  const [loading, setLoading] = useState(false);

  async function addProduct(e: React.FormEvent) {
    e.preventDefault();
    setError('');
    const price = parseBRL(form.price);
    if (!form.name.trim() || !form.category.trim() || !price) {
      setError('Preencha nome, categoria e preço.');
      return;
    }
    setLoading(true);
    const res = await fetch('/api/store/products', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        name: form.name,
        category: form.category,
        description: form.description,
        price,
        promoPrice: form.promoPrice ? parseBRL(form.promoPrice) : null,
      }),
    });
    const data = await res.json();
    setLoading(false);
    if (!res.ok) return setError(data.error ?? 'Não foi possível adicionar o produto.');
    setProducts([normalizeProduct(data.product), ...products]);
    setForm({ name: '', category: '', price: '', promoPrice: '', description: '' });
  }

  async function updateProduct(id: string, patch: Record<string, unknown>) {
    const res = await fetch(`/api/store/products/${id}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(patch),
    });
    const data = await res.json();
    if (res.ok) {
      setProducts((prev) => prev.map((p) => (p.id === id ? normalizeProduct({ ...p, ...data.product }) : p)));
    }
  }

  async function deleteProduct(id: string) {
    if (!confirm('Remover este produto do cardápio?')) return;
    const res = await fetch(`/api/store/products/${id}`, { method: 'DELETE' });
    if (res.ok) setProducts((prev) => prev.filter((p) => p.id !== id));
  }

  return (
    <div>
      <form onSubmit={addProduct} className="bg-surface rounded-2xl p-4 mb-4 grid grid-cols-2 gap-3">
        <div className="col-span-2 flex items-center justify-between">
          <b className="text-sm">Novo produto</b>
          <span className="text-xs text-muted">aparece no cardápio na hora</span>
        </div>
        <label className="block">
          <span className="block text-sm font-medium text-ink mb-1">Nome</span>
          <input className="input" placeholder="Ex.: Risoles de camarão" value={form.name} onChange={(e) => setForm({ ...form, name: e.target.value })} />
        </label>
        <label className="block">
          <span className="block text-sm font-medium text-ink mb-1">Categoria</span>
          <input className="input" placeholder="Ex.: Salgados" value={form.category} onChange={(e) => setForm({ ...form, category: e.target.value })} />
        </label>
        <label className="block">
          <span className="block text-sm font-medium text-ink mb-1">Preço (R$)</span>
          <input className="input" inputMode="decimal" placeholder="8,00" value={form.price} onChange={(e) => setForm({ ...form, price: e.target.value })} />
        </label>
        <label className="block">
          <span className="block text-sm font-medium text-ink mb-1">Preço promocional (opcional)</span>
          <input className="input" inputMode="decimal" placeholder="—" value={form.promoPrice} onChange={(e) => setForm({ ...form, promoPrice: e.target.value })} />
        </label>
        <label className="block col-span-2">
          <span className="block text-sm font-medium text-ink mb-1">Descrição</span>
          <input className="input" placeholder="Recheio, tamanho, peso…" value={form.description} onChange={(e) => setForm({ ...form, description: e.target.value })} />
        </label>
        <div className="col-span-2 flex items-center gap-3">
          <button disabled={loading} className="btn-primary">{loading ? 'Adicionando…' : 'Adicionar ao cardápio'}</button>
          {error && <span className="text-sm text-brand">{error}</span>}
        </div>
      </form>

      {products.length === 0 ? (
        <div className="bg-surface rounded-2xl p-6 text-center">
          <b>Seu cardápio está vazio</b>
          <p className="text-muted text-sm mt-1">Use o formulário acima para adicionar o primeiro produto.</p>
        </div>
      ) : (
        <div className="bg-surface rounded-2xl overflow-x-auto">
          <table className="w-full text-sm">
            <thead>
              <tr className="text-left text-muted border-b border-line">
                <th className="p-3">Produto</th>
                <th className="p-3">Preço</th>
                <th className="p-3">Promoção</th>
                <th className="p-3">Vendidos</th>
                <th className="p-3">No cardápio</th>
                <th className="p-3"></th>
              </tr>
            </thead>
            <tbody>
              {products.map((p) => (
                <tr key={p.id} className="border-b border-line last:border-0">
                  <td className="p-3">
                    <div className="font-semibold">{p.name}</div>
                    <div className="text-xs text-muted">{p.category}</div>
                  </td>
                  <td className="p-3">
                    <PriceInput
                      key={`price-${p.id}-${p.price}`}
                      value={p.price}
                      onSave={(price) => updateProduct(p.id, { price })}
                    />
                  </td>
                  <td className="p-3">
                    <PriceInput
                      key={`promo-${p.id}-${p.promoPrice}`}
                      value={p.promoPrice}
                      placeholder="—"
                      onSave={(promoPrice) => updateProduct(p.id, { promoPrice })}
                    />
                  </td>
                  <td className="p-3 font-mono">{p.sold}</td>
                  <td className="p-3">
                    <button
                      onClick={() => updateProduct(p.id, { active: !p.active })}
                      className={`text-xs font-semibold px-2 py-1 rounded-full ${p.active ? 'bg-green-soft text-green' : 'bg-surface2 text-muted'}`}
                    >
                      {p.active ? 'Ativo' : 'Pausado'}
                    </button>
                  </td>
                  <td className="p-3">
                    <button onClick={() => deleteProduct(p.id)} className="text-xs text-brand font-semibold">
                      Remover
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          <p className="text-xs text-muted p-3">Edite o preço e saia do campo para salvar. Deixe “Promoção” vazio para tirar da promoção.</p>
        </div>
      )}
    </div>
  );
}

function PriceInput({
  value,
  placeholder,
  onSave,
}: {
  value: number | null;
  placeholder?: string;
  onSave: (value: number | null) => void;
}) {
  const [text, setText] = useState(value !== null ? formatBRL(value).replace('R$', '').trim() : '');

  return (
    <input
      className="input w-24"
      inputMode="decimal"
      placeholder={placeholder}
      value={text}
      onChange={(e) => setText(e.target.value)}
      onBlur={() => {
        if (!text.trim()) return onSave(null);
        const parsed = parseBRL(text);
        if (!Number.isNaN(parsed) && parsed > 0) onSave(parsed);
      }}
    />
  );
}
