import Link from 'next/link';
import { formatBRL } from '@/lib/format';
import { TruckIcon, CartIcon } from '@/components/icons';
import { LogoMark } from '@/components/Logo';

export default function StorePreviewCard({
  slug,
  name,
  tagline,
  logoUrl,
  isOpen,
  deliveryFee,
  minOrder,
}: {
  slug: string;
  name: string;
  tagline: string | null;
  logoUrl: string | null;
  isOpen: boolean;
  deliveryFee: number;
  minOrder: number;
}) {
  return (
    <div className="rounded-3xl overflow-hidden shadow-lg">
      <div
        className="h-16 relative"
        style={{ background: 'linear-gradient(150deg, #EA1D2C 0%, #F04A2E 55%, #FF8A00 100%)' }}
      >
        <span className="absolute top-2.5 right-3 text-[10px] font-bold uppercase tracking-wide text-white/80">
          Como o cliente vê
        </span>
      </div>
      <div className="bg-surface px-4 pb-4">
        <div className="flex items-end gap-3 -mt-8">
          <div className="w-16 h-16 rounded-2xl border-4 border-surface bg-surface2 shrink-0 overflow-hidden shadow">
            {logoUrl ? (
              // eslint-disable-next-line @next/next/no-img-element
              <img src={logoUrl} alt={name} className="w-full h-full object-cover" />
            ) : (
              <div className="w-full h-full grid place-items-center">
                <LogoMark size={32} />
              </div>
            )}
          </div>
          <span
            className={`mb-1 text-[10px] font-bold px-2 py-1 rounded-full ${isOpen ? 'bg-green-soft text-green' : 'bg-surface2 text-muted'}`}
          >
            {isOpen ? 'Aberto' : 'Fechado'}
          </span>
        </div>
        <div className="mt-2">
          <h3 className="font-display font-extrabold">{name}</h3>
          {tagline && <p className="text-muted text-xs">{tagline}</p>}
        </div>
        <div className="flex gap-2 mt-2.5">
          <span className="flex items-center gap-1 text-[11px] font-semibold px-2.5 py-1 rounded-full bg-surface2 text-ink">
            <TruckIcon className="w-3 h-3" /> {formatBRL(deliveryFee)}
          </span>
          <span className="flex items-center gap-1 text-[11px] font-semibold px-2.5 py-1 rounded-full bg-surface2 text-ink">
            <CartIcon className="w-3 h-3" /> mín. {formatBRL(minOrder)}
          </span>
        </div>
        <Link
          href={`/${slug}`}
          target="_blank"
          className="block text-center text-xs font-semibold text-brand mt-3 py-2 rounded-lg bg-brand-soft hover:bg-brand/10 transition-colors"
        >
          Ver minha loja como cliente ↗
        </Link>
      </div>
    </div>
  );
}
